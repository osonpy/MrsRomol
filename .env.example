# ──────────────────────────────────────────────────────────────────────────────
# Misr Romol — Environment Variables
# 1. Copy: cp .env.example .env
# 2. Fill in your values
# 3. NEVER commit .env to git!
# ──────────────────────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shop owner's personal Telegram user ID(s) (get it from @userinfobot).
# These always get the super_admin role. Other admins are appointed in the
# Mini App admin section by a super admin.
SUPER_ADMIN_IDS=123456789

# Default chat for admin notifications (group ID or personal ID)
ADMIN_GROUP_ID=123456789

# ALL chat IDs that receive order/payment notifications (group + personal)
# Format: ADMIN_NOTIFY_IDS=-1001234567890,123456789
# If not set, defaults to ADMIN_GROUP_ID only
ADMIN_NOTIFY_IDS=-1001234567890,123456789

# ── Supabase ──────────────────────────────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → API Keys
# Use the SECRET key (sb_secret_… or legacy service_role). The publishable/anon key
# has no access: db/schema.sql opens the database to the backend only.
# Never put this key in the Mini App.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Mini App ──────────────────────────────────────────────────────────────────
# URL where the React Mini App is hosted.
# Local dev: use cloudflare tunnel (see instructions below)
# Production: https://<APP_DOMAIN>
MINI_APP_URL=https://your-tunnel.trycloudflare.com

# Mini App direct link from BotFather (/newapp), e.g. https://t.me/MisrRomolBot/shop.
# Needed for "open order" buttons in group chats (Telegram allows Mini App
# buttons only in private chats). Optional.
MINI_APP_LINK=

# ── API / CORS ─────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the FastAPI backend
ALLOWED_ORIGINS=https://your-tunnel.trycloudflare.com,http://localhost:5173

# ── Server (docker compose on VPS) ────────────────────────────────────────────
# Both DNS A-records must point to the VPS IP. Caddy gets HTTPS certs automatically.
# With these set, use MINI_APP_URL=https://<APP_DOMAIN> and ALLOWED_ORIGINS=https://<APP_DOMAIN>
APP_DOMAIN=app.example.uz
API_DOMAIN=api.example.uz

# ── Development ───────────────────────────────────────────────────────────────
# DEV_MODE=true allows "mock_init_data_for_dev" as valid initData (browser testing)
# and enables /docs. Keep false in production!
DEV_MODE=false
